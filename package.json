{
  "name": "@starter/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "npm run db:up && nx run-many -t serve -p web api",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "ai:sync": "node tools/ai/sync.mts",
    "ai:check": "node tools/ai/sync.mts --check && nx configure-ai-agents --check",
    "postinstall": "nx run api-database:prisma-generate",
    "db:generate": "nx run api-database:prisma-generate",
    "db:migrate": "nx run api-database:prisma-migrate",
    "db:deploy": "nx run api-database:prisma-deploy",
    "db:seed": "nx run api-database:prisma-seed",
    "test:integration": "nx run api:test-integration",
    "build:mobile": "nx build web --configuration=mobile",
    "build:mobile:dev": "nx build web --configuration=mobile-dev",
    "cap:sync": "npm run build:mobile && nx run web:cap-sync",
    "cap:sync:dev": "npm run build:mobile:dev && nx run web:cap-sync:dev",
    "cap:ios": "npm run cap:sync && cap open ios",
    "cap:android": "npm run cap:sync && cap open android",
    "cap:ios:dev": "npm run cap:sync:dev && cap open ios",
    "cap:android:dev": "npm run cap:sync:dev && cap open android",
    "cap:dev:ios": "npm run build:mobile:dev && nx run web:cap-run:ios",
    "cap:dev:android": "npm run build:mobile:dev && nx run web:cap-run:android",
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:check": "prisma migrate diff --config libs/api/database/prisma.config.ts --from-config-datasource --to-schema libs/api/database/prisma/schema.prisma --exit-code"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "~22.2.2",
    "@angular/compiler": "~22.2.2",
    "@angular/core": "~22.2.2",
    "@angular/forms": "~22.2.2",
    "@angular/platform-browser": "~22.2.2",
    "@angular/router": "~22.2.2",
    "@aparajita/capacitor-secure-storage": "^8.0.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@nestjs/common": "~11.2.7",
    "@nestjs/core": "~11.2.7",
    "@nestjs/jwt": "~11.0.2",
    "@nestjs/platform-express": "~11.2.7",
    "@nestjs/swagger": "~11.4.7",
    "@nestjs/throttler": "^6.7.1",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.0",
    "rxjs": "~7.8.0",
    "zod": "~4.6.5"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "~2.8.0",
    "@analogjs/vitest-angular": "~2.8.0",
    "@angular-devkit/core": "~22.2.2",
    "@angular-devkit/schematics": "~22.2.2",
    "@angular/build": "~22.2.2",
    "@angular/cli": "~22.2.2",
    "@angular/compiler-cli": "~22.2.2",
    "@angular/language-service": "~22.2.2",
    "@capacitor/cli": "^8.5.3",
    "@eslint/js": "^9.8.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "~11.2.7",
    "@nx/angular": "23.3.0",
    "@nx/devkit": "23.3.0",
    "@nx/eslint": "23.3.0",
    "@nx/eslint-plugin": "23.3.0",
    "@nx/js": "23.3.0",
    "@nx/nest": "23.3.0",
    "@nx/node": "23.3.0",
    "@nx/playwright": "23.3.0",
    "@nx/vite": "23.3.0",
    "@nx/vitest": "23.3.0",
    "@nx/web": "23.3.0",
    "@nx/webpack": "23.3.0",
    "@nx/workspace": "23.3.0",
    "@oxc-project/runtime": "^0.115.0",
    "@playwright/test": "^1.37.0",
    "@schematics/angular": "~22.2.2",
    "@swc/helpers": "~0.5.18",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/utils": "^8.58.0",
    "@vitest/coverage-v8": "^4.0.0",
    "@vitest/ui": "^4.0.0",
    "angular-eslint": "^22.1.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-playwright": "^1.6.2",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "husky": "^9.1.7",
    "jsdom": "^27.1.0",
    "lint-staged": "^17.6.0",
    "nx": "23.3.0",
    "prettier": "~3.6.2",
    "prisma": "^7.10.0",
    "supertest": "^7.3.1",
    "tslib": "^2.3.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.8",
    "webpack": "~5.110.0",
    "webpack-cli": "^7.0.0",
    "webpack-dev-server": "^5.2.1"
  },
  "overrides": {
    "undici": "^7.30.0",
    "mysql2": "^3.24.5",
    "deepmerge-ts": "^8.0.2",
    "@nestjs/swagger": {
      "js-yaml": "^5.4.3"
    }
  },
  "engines": {
    "node": "^24.15.0",
    "npm": ">=11.0.0"
  },
  "lint-staged": {
    "*.{ts,mts,cts,js,mjs,cjs}": [
      "eslint --flag v10_config_lookup_from_file --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,html,scss,css,yml,yaml}": "prettier --write --ignore-unknown"
  }
}
