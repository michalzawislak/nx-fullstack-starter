# Copy to .env and adjust. .env is git-ignored (PRD BE-13).
# Variables are validated at API startup from step 5 on (BE-12).

# API
PORT=3000

# PostgreSQL (docker-compose.yml)
POSTGRES_USER=starter
POSTGRES_PASSWORD=starter
POSTGRES_DB=starter
POSTGRES_PORT=5432
DATABASE_URL=postgresql://starter:starter@localhost:5432/starter
