# Copy to .env and adjust. .env is git-ignored (PRD BE-13).
# The API validates these variables at startup and stops with a list of problems (BE-12).

# --- API ---
NODE_ENV=development
# Not PORT: Nx passes .env to every task and the Angular dev server would take that port too.
API_PORT=3000
# At least 32 random characters, e.g. `openssl rand -base64 48`. Never reuse in production.
JWT_ACCESS_SECRET=change-me-local-development-secret-0123456789
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Comma-separated list of allowed origins (BE-14): web dev server, iOS and Android WebViews.
CORS_ORIGINS=http://localhost:4200,capacitor://localhost,https://localhost
AUTH_RATE_LIMIT_PER_MINUTE=20
# Minimum supported app version per platform; older apps get APP_VERSION_UNSUPPORTED (CON-6).
MIN_APP_VERSION_WEB=0.0.0
MIN_APP_VERSION_IOS=0.0.0
MIN_APP_VERSION_ANDROID=0.0.0

# --- PostgreSQL (docker-compose.yml) ---
POSTGRES_USER=starter
POSTGRES_PASSWORD=starter
POSTGRES_DB=starter
POSTGRES_PORT=5432
DATABASE_URL=postgresql://starter:starter@localhost:5432/starter

# --- Tests ---
# Database for npm run test:integration (created by tools/docker/postgres-init).
TEST_DATABASE_URL=postgresql://starter:starter@localhost:5432/starter_test

# --- Seed (npm run db:seed) ---
SEED_USER_EMAIL=demo@example.com
SEED_USER_PASSWORD=starter-password
